# Copy to .env.r1.local and fill from .r1-local/manifest.json (gitignored).
# Load when running Next against UAT for R1 dev:
#   set -a && source .env.r1.local && set +a && npm run dev
#
# Optional verbose browser console (off by default):
#   NEXT_PUBLIC_DEV_LOG=register,auth,dal,household
# Or in DevTools: localStorage.setItem('gk:dev-log', '*')
#
# Structured debug panel (DAL/fetch traces): Ctrl+Shift+D or localStorage gk:debug-panel=1

NEXT_PUBLIC_SUPABASE_URL=https://gekouvbeujfkiaorshim.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE-UAT-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=PASTE-UAT-SERVICE-ROLE-KEY
DATABASE_URL=postgresql://postgres.[POOLER-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
