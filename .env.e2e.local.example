# Application under test (Next.js dev server)
BASE_URL=http://localhost:9002

# Demo mode for e2e login tests
NEXT_PUBLIC_DATABASE_MODE=demo
NEXT_PUBLIC_SHOW_DEMO_FEATURES=true

# Local Supabase instance
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE=your-local-service-role-key

# Local MailHog instance
MAILHOG_API=http://localhost:8025/api/v2