# local CI manifest (secrets — do not commit manifest.json)
.ci-local/*
!.ci-local/manifest.example.json
# generated at prebuild — commit placeholder; Vercel overwrites on each build
src/generated/*
!src/generated/build-info.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build

# documentation site
/doc-site/build
/doc-site/.docusaurus

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*
.env.uat.example
!.env.uat.example

# E2E environment files (keep examples, ignore actual configs with real keys)
.env.e2e.local
.env.e2e.ci
!.env.e2e.*.example

# firebase
firebase-debug.log
firestore-debug.log

uat-backup-*

doc-site/
# Sentry Config File
.env.sentry-build-plugin

# Claude local settings (personal overrides, not for team)
.claude/settings.local.json
.claude/worktrees/**/.claude/settings.local.json
